model fourbar_straightline
  inner PlanarMechanics.PlanarWorld planarWorld(enableAnimation=false);
  PlanarMechanics.Parts.Fixed fixed_A(r={0,0});
  PlanarMechanics.Parts.Fixed fixed_D(r={4.95054930932,0});
  PlanarMechanics.Parts.Body body_crank(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.Body body_coupler(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.Body body_rocker(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.FixedTranslation ft_A_crank(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_B_crank(r={1.13477825255,0});
  PlanarMechanics.Parts.FixedTranslation ft_B_coupler(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_C_coupler(r={3.16094341867,0});
  PlanarMechanics.Parts.FixedTranslation ft_C_rocker(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_D_rocker(r={4.35860066691,0});
  PlanarMechanics.Joints.Revolute rev_A(useFlange=true, phi(start=1.65206764469e-27, fixed=true), stateSelect=StateSelect.always);
  PlanarMechanics.Joints.Revolute rev_B(phi(start=-1.33846256647));
  PlanarMechanics.Joints.Revolute rev_C(phi(start=2.12192170786));
  PlanarMechanics.Joints.Revolute rev_D(phi(start=-0.783459141391));
  Modelica.Mechanics.Rotational.Sources.Position drv(exact=true);
  Modelica.Blocks.Sources.Ramp ramp(height=6.28318530718, duration=1, offset=1.65206764469e-27);
  output Real poi_x;
  output Real poi_y;
equation
  connect(fixed_A.frame, rev_A.frame_a);
  connect(ft_A_crank.frame_b, rev_A.frame_b);
  connect(body_crank.frame_a, ft_A_crank.frame_a);
  connect(ft_B_crank.frame_b, rev_B.frame_a);
  connect(body_crank.frame_a, ft_B_crank.frame_a);
  connect(ft_B_coupler.frame_b, rev_B.frame_b);
  connect(body_coupler.frame_a, ft_B_coupler.frame_a);
  connect(ft_C_coupler.frame_b, rev_C.frame_a);
  connect(body_coupler.frame_a, ft_C_coupler.frame_a);
  connect(ft_C_rocker.frame_b, rev_C.frame_b);
  connect(body_rocker.frame_a, ft_C_rocker.frame_a);
  connect(ft_D_rocker.frame_b, rev_D.frame_a);
  connect(body_rocker.frame_a, ft_D_rocker.frame_a);
  connect(fixed_D.frame, rev_D.frame_b);
  connect(drv.flange, rev_A.flange_a);
  connect(ramp.y, drv.phi_ref);
  poi_x = body_coupler.r[1] + (3.21085035015)*cos(body_coupler.phi) - (0.795742781435)*sin(body_coupler.phi);
  poi_y = body_coupler.r[2] + (3.21085035015)*sin(body_coupler.phi) + (0.795742781435)*cos(body_coupler.phi);
  annotation(experiment(StopTime=1, Interval=0.002));
end fourbar_straightline;
