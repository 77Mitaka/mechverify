model sixbar_watt
  inner PlanarMechanics.PlanarWorld planarWorld(enableAnimation=false);
  PlanarMechanics.Parts.Fixed fixed_A(r={0,0});
  PlanarMechanics.Parts.Fixed fixed_D(r={2.5,0});
  PlanarMechanics.Parts.Fixed fixed_G(r={1.25,-2.5});
  PlanarMechanics.Parts.Body body_L1(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.Body body_L2(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.Body body_L3(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.Body body_L4(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.Body body_L5(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.FixedTranslation ft_A_L1(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_D_L3(r={2.5,6.24500451352e-17});
  PlanarMechanics.Parts.FixedTranslation ft_G_L5(r={1.94756590485,0});
  PlanarMechanics.Parts.FixedTranslation ft_B_L1(r={1,0});
  PlanarMechanics.Parts.FixedTranslation ft_B_L2(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_C_L2(r={2.5,2.22044604925e-16});
  PlanarMechanics.Parts.FixedTranslation ft_C_L3(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_E_L3(r={1.5,-1.38777878078e-16});
  PlanarMechanics.Parts.FixedTranslation ft_E_L4(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_F_L4(r={1.94756590485,-2.08166817117e-17});
  PlanarMechanics.Parts.FixedTranslation ft_F_L5(r={0,0});
  PlanarMechanics.Joints.Revolute rev_A(useFlange=true, phi(start=0.785398163397, fixed=true), stateSelect=StateSelect.always);
  PlanarMechanics.Joints.Revolute rev_D(phi(start=-1.55075562659));
  PlanarMechanics.Joints.Revolute rev_G(phi(start=-1.59889512029));
  PlanarMechanics.Joints.Revolute rev_B(phi(start=0.0140284338033));
  PlanarMechanics.Joints.Revolute rev_C(phi(start=-2.35018222379));
  PlanarMechanics.Joints.Revolute rev_E(phi(start=-0.667851624879));
  PlanarMechanics.Joints.Revolute rev_F(phi(start=0.619712131176));
  Modelica.Mechanics.Rotational.Sources.Position drv(exact=true);
  Modelica.Blocks.Sources.Ramp ramp(height=6.28318530718, duration=1, offset=0.785398163397);
  output Real poi_x;
  output Real poi_y;
equation
  connect(fixed_A.frame, rev_A.frame_a);
  connect(ft_A_L1.frame_b, rev_A.frame_b);
  connect(body_L1.frame_a, ft_A_L1.frame_a);
  connect(fixed_D.frame, rev_D.frame_a);
  connect(ft_D_L3.frame_b, rev_D.frame_b);
  connect(body_L3.frame_a, ft_D_L3.frame_a);
  connect(fixed_G.frame, rev_G.frame_a);
  connect(ft_G_L5.frame_b, rev_G.frame_b);
  connect(body_L5.frame_a, ft_G_L5.frame_a);
  connect(ft_B_L1.frame_b, rev_B.frame_a);
  connect(body_L1.frame_a, ft_B_L1.frame_a);
  connect(ft_B_L2.frame_b, rev_B.frame_b);
  connect(body_L2.frame_a, ft_B_L2.frame_a);
  connect(ft_C_L2.frame_b, rev_C.frame_a);
  connect(body_L2.frame_a, ft_C_L2.frame_a);
  connect(ft_C_L3.frame_b, rev_C.frame_b);
  connect(body_L3.frame_a, ft_C_L3.frame_a);
  connect(ft_E_L3.frame_b, rev_E.frame_a);
  connect(body_L3.frame_a, ft_E_L3.frame_a);
  connect(ft_E_L4.frame_b, rev_E.frame_b);
  connect(body_L4.frame_a, ft_E_L4.frame_a);
  connect(ft_F_L4.frame_b, rev_F.frame_a);
  connect(body_L4.frame_a, ft_F_L4.frame_a);
  connect(ft_F_L5.frame_b, rev_F.frame_b);
  connect(body_L5.frame_a, ft_F_L5.frame_a);
  connect(drv.flange, rev_A.flange_a);
  connect(ramp.y, drv.phi_ref);
  poi_x = body_L4.r[1] + (1.94756590485)*cos(body_L4.phi) - (0)*sin(body_L4.phi);
  poi_y = body_L4.r[2] + (1.94756590485)*sin(body_L4.phi) + (0)*cos(body_L4.phi);
  annotation(experiment(StopTime=1, Interval=0.002));
end sixbar_watt;
