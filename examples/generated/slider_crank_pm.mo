model slider_crank
  inner PlanarMechanics.PlanarWorld planarWorld(enableAnimation=false);
  PlanarMechanics.Parts.Fixed fixed_A(r={0,0});
  PlanarMechanics.Parts.Fixed fixed_D(r={0,0});
  PlanarMechanics.Parts.Body body_crank(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.Body body_coupler(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.Body body_slider(m=1, I=0.01, enableGravity=false);
  PlanarMechanics.Parts.FixedTranslation ft_A_crank(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_B_crank(r={1,0});
  PlanarMechanics.Parts.FixedTranslation ft_B_coupler(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_C_coupler(r={2.5,0});
  PlanarMechanics.Parts.FixedTranslation ft_C_slider(r={0,0});
  PlanarMechanics.Parts.FixedTranslation ft_D_slider(r={0,0});
  PlanarMechanics.Joints.Revolute rev_A(useFlange=true, phi(start=1.57079632679, fixed=true), stateSelect=StateSelect.always);
  PlanarMechanics.Joints.Revolute rev_B(phi(start=-1.98231317286));
  PlanarMechanics.Joints.Revolute rev_C(phi(start=0.411516846067));
  PlanarMechanics.Joints.Prismatic pri_D(r={1,0}, s(start=2.29128784748));
  Modelica.Mechanics.Rotational.Sources.Position drv(exact=true);
  Modelica.Blocks.Sources.Ramp ramp(height=6.28318530718, duration=1, offset=1.57079632679);
  output Real poi_x;
  output Real poi_y;
equation
  connect(fixed_A.frame, rev_A.frame_a);
  connect(ft_A_crank.frame_b, rev_A.frame_b);
  connect(body_crank.frame_a, ft_A_crank.frame_a);
  connect(ft_B_crank.frame_b, rev_B.frame_a);
  connect(body_crank.frame_a, ft_B_crank.frame_a);
  connect(ft_B_coupler.frame_b, rev_B.frame_b);
  connect(body_coupler.frame_a, ft_B_coupler.frame_a);
  connect(ft_C_coupler.frame_b, rev_C.frame_a);
  connect(body_coupler.frame_a, ft_C_coupler.frame_a);
  connect(ft_C_slider.frame_b, rev_C.frame_b);
  connect(body_slider.frame_a, ft_C_slider.frame_a);
  connect(fixed_D.frame, pri_D.frame_a);
  connect(ft_D_slider.frame_b, pri_D.frame_b);
  connect(body_slider.frame_a, ft_D_slider.frame_a);
  connect(drv.flange, rev_A.flange_a);
  connect(ramp.y, drv.phi_ref);
  poi_x = body_slider.r[1] + (0)*cos(body_slider.phi) - (0)*sin(body_slider.phi);
  poi_y = body_slider.r[2] + (0)*sin(body_slider.phi) + (0)*cos(body_slider.phi);
  annotation(experiment(StopTime=1, Interval=0.002));
end slider_crank;
